        <mxCell id="receive_loop" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="接收固件切片&#xa;receive_firmwareCarve()" vertex="1">
