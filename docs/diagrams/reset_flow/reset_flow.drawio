        <mxCell id="validate_size" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" value="大小一致？&#xa;(totalLen == expected_size)" vertex="1">
          <mxGeometry height="80" width="240" x="280" y="770" as="geometry" />
