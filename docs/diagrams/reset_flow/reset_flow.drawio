        </mxCell>
        <mxCell id="erase" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" value="擦除A区&#xa;BootLoader_erase_flash()" vertex="1">
