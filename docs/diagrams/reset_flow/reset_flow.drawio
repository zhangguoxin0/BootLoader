        <mxCell id="print_expected" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" value="printf(&quot;Expected: %lu bytes&quot;)" vertex="1">
