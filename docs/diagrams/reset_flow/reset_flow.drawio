        <mxCell id="print_error" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" value="printf(&quot;Error: size mismatch&quot;)" vertex="1">
