        <mxCell id="jump_app" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" value="跳转到App&#xa;BootLoader_jump_to_App()" vertex="1">
